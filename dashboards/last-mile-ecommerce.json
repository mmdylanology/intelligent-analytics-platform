        {
          "dataset": "nucleo",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  executor_status as reason,\n  COUNT(*) as count\nFROM executor_status_updates esu\nJOIN packages p ON esu.package_id = p.package_id\nWHERE executor_status NOT IN ('CREATED', 'RECEIVED')\n  AND executor_status NOT ILIKE '%exitosa%'\n  AND executor_status NOT ILIKE '%success%'\n  AND (\n    '${carrier:csv}' = '' \n    OR COALESCE(p.executor_name, 'Unknown') IN (${carrier:singlequote})\n  )\nGROUP BY executor_status\nORDER BY count DESC\nLIMIT 10;",
          "refId": "A",
