        {
          "dataset": "nucleo",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  COALESCE(p.executor_name, 'Unknown') as carrier,\n  COUNT(*) as package_count,\n  ROUND(AVG(EXTRACT(EPOCH FROM (latest_status_occurred_at - created_at))/3600)::numeric, 2) as avg_hours\nFROM packages p\nWHERE latest_status_occurred_at IS NOT NULL\n  AND latest_status_occurred_at > created_at\n  AND (\n    '${carrier:csv}' = '' \n    OR COALESCE(p.executor_name, 'Unknown') IN (${carrier:singlequote})\n  )\nGROUP BY p.executor_name\nHAVING COUNT(*) > 5\nORDER BY package_count DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
