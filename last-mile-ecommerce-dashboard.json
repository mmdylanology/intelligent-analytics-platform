          "rawQuery": true,
          "rawSql": "SELECT \n  CASE \n    WHEN executor_status = 'CREATED' THEN 'Created'\n    WHEN executor_status ILIKE '%exitosa%' THEN 'Delivered Successfully'\n    WHEN executor_status ILIKE '%fallida%' OR executor_status ILIKE '%fallido%' THEN 'Failed Delivery'\n    WHEN executor_status ILIKE '%custodia%' THEN 'In Custody'\n    WHEN executor_status ILIKE '%tránsito%' OR executor_status ILIKE '%transito%' THEN 'In Transit'\n    ELSE 'Other'\n  END as status,\n  COUNT(*) as count\nFROM executor_status_updates esu\nJOIN packages p ON esu.package_id = p.package_id\nWHERE \n  '${carrier:csv}' = '' \n  OR COALESCE(p.executor_name, 'Unknown') IN (${carrier:singlequote})\nGROUP BY status\nORDER BY count DESC;",
