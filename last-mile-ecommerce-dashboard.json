        {
          "dataset": "nucleo",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH delivery_times AS (\n    SELECT \n        p.package_id,\n        MIN(CASE WHEN pal.new_canonical_status_code = '7020' THEN pal.new_status_occurred_at END) as picked,\n        MIN(CASE WHEN pal.new_canonical_status_code = '7050' THEN pal.new_status_occurred_at END) as delivered\n    FROM packages p\n    JOIN packages_activity_log pal ON p.package_id = pal.package_id\n    GROUP BY p.package_id\n)\nSELECT ROUND(AVG(EXTRACT(EPOCH FROM (delivered - picked)) / 3600)::numeric, 2) as value\nFROM delivery_times\nWHERE picked IS NOT NULL AND delivered IS NOT NULL",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
